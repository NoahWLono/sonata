// Emit tracks in their original order, preserving simultaneous-event order.
let total_events = 0;
total_events = total_events + perform_track(0, 0, 1, 2);
total_events = total_events + perform_track(1, 1, 2, 2);
total_events = total_events + perform_track(2, 2, 49, 11986);
total_events = total_events + perform_track(3, 49, 56, 1668);
