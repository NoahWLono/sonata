total_events = total_events + perform_track(9, 107, 121, 3424);
total_events = total_events + perform_track(10, 121, 127, 1520);
total_events = total_events + perform_track(11, 127, 128, 190);
total_events = total_events + perform_track(12, 128, 129, 190);
assert(total_events == 31028);
return total_events;
