// Emit tracks in their original order, preserving simultaneous-event order.
let total_events = 0;
total_events = total_events + perform_track(0, 0, 1, 9);
total_events = total_events + perform_track(1, 1, 17, 3937);
assert(total_events == 3946);
return total_events;
