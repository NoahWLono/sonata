// Local performance converted from user-supplied MIDI.
// Run with score_bridge.py perform; keep the .inputs.json beside this file.
// Catalog arrays are raw MIDI messages; comments name their musical meaning.
// Each fixture word = delta_ticks * 65536 + zero-based catalog index.
// Editing a catalog print changes every use of that message in the score.
fn perform_track(track_id, first_page, end_page, expected_events) {
    print([track_id, end_page - first_page, expected_events]);
    let emitted = 0;
    for page in first_page..end_page {
        let events = input(page);
        assert(len(events) > 0);
        emitted = emitted + len(events);
        print(events);
    }
    assert(emitted == expected_events);
    return emitted;
}
// Protocol magic, version, PPQ, MIDI type, tracks, catalog entries.
print([1397706324, 1, 1024, 1, 2, 90]);
print([255, 88, 4, 4, 2, 24, 8]); // 0: "MetaMessage('time_signature', numerator=4, denominator=4, clocks_per_click=24, notated_32nd_notes_per_beat=8, time=0)"
print([255, 89, 2, 253, 0]); // 1: "MetaMessage('key_signature', key='Eb', time=0)"
print([255, 81, 3, 12, 11, 225]); // 2: "MetaMessage('set_tempo', tempo=789473, time=0)"
print([255, 88, 4, 2, 2, 24, 8]); // 3: "MetaMessage('time_signature', numerator=2, denominator=4, clocks_per_click=24, notated_32nd_notes_per_beat=8, time=0)"
print([255, 81, 3, 7, 68, 30]); // 4: "MetaMessage('set_tempo', tempo=476190, time=0)"
print([255, 47, 0]); // 5: "MetaMessage('end_of_track', time=0)"
print([255, 3, 20, 65, 99, 111, 117, 115, 116, 105, 99, 32, 71, 114, 97, 110, 100, 32, 80, 105, 97, 110, 111]); // 6: "MetaMessage('track_name', name='Acoustic Grand Piano', time=0)"
print([192, 0]); // 7: "program_change channel=0 program=0 time=0"
print([144, 72, 64]); // 8: "note_on channel=0 note=72 velocity=64 time=0"
print([144, 60, 64]); // 9: "note_on channel=0 note=60 velocity=64 time=0"
