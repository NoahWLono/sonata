fn search(values, target) {
    let low = 0;
    let high = len(values) - 1;
    while (low <= high) {
        print([low, high]);
        let middle = (low + high) / 2;
        if (values[middle] == target) {
            return middle;
        }
        if (values[middle] < target) {
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
    return -1;
}
let found = search([1, 3, 5, 7, 9, 11, 13], 8);
print(found);
return found;
